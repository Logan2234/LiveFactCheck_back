# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# Whisper local (tiny, base, small, medium, large)
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu

# Niveau de log des loggers applicatifs (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Panel admin
ADMIN_PASSWORD=change-me
# Secret de signature JWT (générer une chaîne aléatoire longue)
JWT_SECRET=change-me-too-long-random-string
JWT_EXPIRE_HOURS=12
